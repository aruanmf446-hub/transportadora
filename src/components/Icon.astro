---
/** Minimal technical icon set (1.25px strokes). */
interface Props { name: 'arrow' | 'arrow-diag' | 'plus' | 'close' | 'menu' | 'whatsapp' | 'mail' | 'pin' | 'phone' | 'route' | 'search' | 'download' | 'external' | 'rotate' | 'check'; size?: number; class?: string }
const { name, size = 16, class: cls } = Astro.props;
const paths: Record<string, string> = {
  arrow: '<path d="M2 8h12M9 3l5 5-5 5"/>',
  'arrow-diag': '<path d="M4 12L12 4M5 4h7v7"/>',
  plus: '<path d="M8 2v12M2 8h12"/>',
  close: '<path d="M3 3l10 10M13 3L3 13"/>',
  menu: '<path d="M2 5h12M2 11h12"/>',
  mail: '<path d="M1.5 3.5h13v9h-13z"/><path d="M1.5 3.5L8 9l6.5-5.5"/>',
  pin: '<path d="M8 15s5-4.6 5-8.5A5 5 0 0 0 3 6.5C3 10.4 8 15 8 15z"/><circle cx="8" cy="6.5" r="1.8"/>',
  phone: '<path d="M4.5 1.5h-2a1 1 0 0 0-1 1.1A12.5 12.5 0 0 0 13.4 14.5a1 1 0 0 0 1.1-1v-2l-3-1-1.5 1.5a8 8 0 0 1-4-4L7.5 5.5l-1-3z"/>',
  route: '<circle cx="3.5" cy="12.5" r="1.8"/><circle cx="12.5" cy="3.5" r="1.8"/><path d="M5.3 12.5H11a2 2 0 0 0 0-4H5a2 2 0 0 1 0-4h5.7"/>',
  search: '<circle cx="7" cy="7" r="4.8"/><path d="M10.5 10.5L14.5 14.5"/>',
  download: '<path d="M8 2v9M4 7l4 4 4-4M2.5 14h11"/>',
  external: '<path d="M9 2.5h4.5V7M13.5 2.5L7 9M11.5 9.5v4h-9v-9h4"/>',
  rotate: '<path d="M13.5 8A5.5 5.5 0 1 1 11.9 4.1"/><path d="M13.5 1.8v3.4h-3.4"/>',
  check: '<path d="M2.5 8.5l3.5 3.5 7.5-8"/>',
  whatsapp: '<path d="M2.2 13.8l.8-2.9A6 6 0 1 1 5.2 13z"/><path d="M6 5.4c.1-.3.4-.4.6-.4h.4l.7 1.5-.5.7a4 4 0 0 0 1.6 1.6l.7-.5 1.5.7v.4c0 .3-.2.6-.4.7-1.3.6-3.3-.6-4.2-1.6S5.4 6.6 6 5.4z"/>',
};
---
<svg class={cls} width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" aria-hidden="true" focusable="false" set:html={paths[name]} />
