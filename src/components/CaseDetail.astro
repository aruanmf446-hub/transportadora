---
import Img from './Img.astro';
import { site, url, caseUrl, serviceUrl } from '../lib/site';
import type { Case, PageConfig } from '../config/schema';
interface Props { item: Case; parent: PageConfig }
const { item: c, parent } = Astro.props;
const idx = site.data.cases.indexOf(c);
const next = site.data.cases.filter((x) => x.page)[(site.data.cases.filter((x) => x.page).indexOf(c) + 1) % site.data.cases.filter((x) => x.page).length];
const services = c.services.map((s) => site.data.services.find((x) => x.slug === s)).filter(Boolean);
void idx;
---
<article class="section cd" data-theme="light">
  <div class="container">
    <nav class="cd__crumbs mono" aria-label="Você está em" data-reveal="fade" data-immediate data-delay="0.4">
      <a href={url('')}>Início</a><span aria-hidden="true">/</span><a href={url(parent.path)}>{parent.navLabel ?? parent.title}</a><span aria-hidden="true">/</span><span aria-current="page">{c.client}</span>
    </nav>
    <div class="cd__meta mono" data-reveal="fade" data-immediate data-delay="0.5"><span>{c.sector}</span><span>{c.year}</span><span>{c.client}</span></div>
    <h1 class="h1 cd__title" data-reveal="lines" data-immediate data-delay="0.55">{c.title}</h1>
    <p class="lead" data-reveal="fade" data-immediate data-delay="0.9">{c.summary}</p>
    {site.demo.enabled && <p class="demo-flag cd__flag">Case fictício para demonstração</p>}
  </div>
  {c.image && <div class="container"><div class="media cd__media" data-reveal="mask" data-immediate data-delay="0.7"><div class="cd__inner" data-parallax="0.14"><Img image={c.image} loading="eager" sizes="100vw" /></div></div></div>}
  <div class="container cd__body">
    <section class="cd__block" aria-labelledby="cd-ch"><h2 id="cd-ch" class="eyebrow">Desafio</h2><p class="h3" data-reveal="lines">{c.challenge}</p></section>
    <section class="cd__block" aria-labelledby="cd-so"><h2 id="cd-so" class="eyebrow">Solução</h2><p class="body cd__text" data-reveal="fade">{c.solution}</p>
      {services.length > 0 && <ul class="cd__services">{services.map((s) => { const h = serviceUrl(s!.slug); return <li>{h ? <a class="link" href={h}>{s!.title}</a> : s!.title}</li>; })}</ul>}
    </section>
  </div>
  {c.results.length > 0 && (
    <div class="container"><dl class="cd__results">{c.results.map((r) => <div data-reveal="fade"><dt class="mono muted">{r.label}</dt><dd>{r.value}</dd></div>)}</dl></div>
  )}
  {next && next.slug !== c.slug && (
    <div class="container"><a class="cd__next" href={caseUrl(next.slug)!}><span class="mono muted">Próximo case</span><span class="h2">{next.title}</span></a></div>
  )}
</article>
<style>
  .cd { padding-top: calc(var(--header-h) + clamp(56px, 9vw, 150px)); }
  .cd__crumbs { display: flex; flex-wrap: wrap; gap: 10px; color: var(--muted); margin-bottom: 32px; }
  .cd__meta { display: flex; gap: 24px; color: var(--muted); margin-bottom: 20px; }
  .cd__title { max-width: 18ch; margin-bottom: 28px; }
  .cd__flag { margin-top: 20px; }
  .cd__media { aspect-ratio: 21 / 9; margin-top: clamp(48px, 6vw, 96px); }
  .cd__inner { position: absolute; inset: -10% 0; }
  .cd__body { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); margin-top: var(--section-y-sm); }
  .cd__block { display: grid; gap: 20px; align-content: start; }
  .cd__text { font-size: 1.125rem; }
  .cd__services { display: flex; gap: 20px; flex-wrap: wrap; }
  .cd__results { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); border-top: 1px solid var(--fg); margin-top: var(--section-y-sm); }
  .cd__results div { padding: 24px 24px 24px 0; display: grid; gap: 10px; }
  .cd__results dd { margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 6vw, 6rem); letter-spacing: -0.05em; line-height: 1; color: var(--accent); }
  .cd__next { display: grid; gap: 12px; margin-top: var(--section-y-sm); padding-top: 32px; border-top: 1px solid var(--line); transition: color 0.3s; }
  .cd__next:hover { color: var(--accent); }
  @media (max-width: 900px) { .cd__body { grid-template-columns: 1fr; } .cd__media { aspect-ratio: 4 / 3; } }
</style>
