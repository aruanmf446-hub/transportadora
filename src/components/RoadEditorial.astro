<script>
  import { buildMessage, whatsappUrl, mailtoUrl } from '../lib/messages';
  const toggle = document.querySelector<HTMLButtonElement>('[data-road-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-road-menu]');
  const closeMenu = () => { menu?.classList.remove('is-open'); toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'Abrir menu'); };
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu'); menu?.classList.toggle('is-open', open); });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeMenu(); if (document.activeElement && menu?.contains(document.activeElement)) toggle?.focus(); } });
  const quote = document.querySelector<HTMLFormElement>('[data-road-quote]');
  document.querySelector<HTMLFormElement>('[data-road-route]')?.addEventListener('submit', e => { e.preventDefault(); const form = e.currentTarget as HTMLFormElement; const values = new FormData(form); for (const key of ['origin', 'destination']) { const field = quote?.elements.namedItem(key) as HTMLInputElement; if (field) field.value = String(values.get(key) ?? ''); } document.querySelector('#cotacao')?.scrollIntoView(); (quote?.elements.namedItem('name') as HTMLInputElement)?.focus({ preventScroll: true }); });
  quote?.addEventListener('submit', e => { e.preventDefault(); const button = (e as SubmitEvent).submitter as HTMLButtonElement | null; const data = Object.fromEntries(new FormData(quote).entries()) as Record<string, string>; const message = buildMessage(`Solicitação de transporte — ${quote.dataset.brand}`, data); const status = document.querySelector<HTMLElement>('[data-road-status]'); if (button?.value === 'whatsapp' && quote.dataset.number) { window.open(whatsappUrl(quote.dataset.number, message), '_blank', 'noopener,noreferrer'); if (status) status.textContent = 'Sua mensagem foi preparada no WhatsApp. Revise e envie para solicitar a proposta.'; } else { window.location.href = mailtoUrl(quote.dataset.email ?? '', 'Solicitação de transporte', message); if (status) status.textContent = 'Sua mensagem foi preparada no aplicativo de e-mail.'; } });
</script>
