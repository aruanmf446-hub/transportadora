---
import '../styles/global.css';
import Img from './Img.astro';
import Icon from './Icon.astro';
import { site, url } from '../lib/site';
import { themeVars } from '../lib/theme';
const { brand, company, demo, integrations } = site;
const photo = { src: 'media/road-editorial.jpg', alt: 'Caminhão branco com contêiner em uma estrada de pista simples', focus: '30% 60%' };
const whatsapp = integrations.whatsapp?.enabled ? integrations.whatsapp.number : undefined;
const quoteEmail = integrations.quote?.email ?? company.contact.email;
const serviceLinks = site.data.services.slice(0, 2);
---
<!doctype html>
<html lang="pt-BR" data-motion="none" data-transitions="off">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#171a18" />
  <title>{brand.name} — Proposta visual / Despacho de estrada</title>
  <meta name="description" content="Proposta visual para uma transportadora: carga, origem, destino e atendimento direto." />
  <link rel="icon" href={site.brand.favicon} />
  <style set:html={themeVars(site.theme)}></style>
</head>
<body class="road">
  <a class="road-skip" href="#principal">Pular para o conteúdo</a>
  <div class="edition"><span>ESTUDO DE IDENTIDADE / DESPACHO DE ESTRADA</span><span>MARCA FICTÍCIA · PRÉVIA</span></div>
  <header class="masthead">
    <a class="wordmark" href="#principal" aria-label={`${brand.name} — início`}>
      <svg viewBox="0 0 46 40" aria-hidden="true"><path d="M0 0h21l20 20-20 20H0l20-20Z" fill="currentColor"/><path d="M29 0h7l10 10v20L36 40h-7l20-20Z" fill="var(--signal)"/></svg>
      <span>{brand.name.toLowerCase()}<small>TRANSPORTES</small></span>
    </a>
    <nav class="road-nav" aria-label="Navegação principal" id="road-nav" data-road-menu>
      <a href="#servicos">Serviços</a><a href="#percurso">Como funciona</a><a href="#atendimento">Atendimento</a>
    </nav>
    <a class="header-quote" href="#cotacao">Pedir uma proposta <span aria-hidden="true"><Icon name="arrow-diag" size={22} /></span></a>
    <button class="road-menu-toggle" type="button" aria-label="Abrir menu" aria-controls="road-nav" aria-expanded="false" data-road-menu-toggle><span></span><span></span></button>
  </header>
  <main id="principal">
    <section class="departure" aria-labelledby="departure-title">
      <div class="departure__photo"><Img image={photo} loading="eager" fetchpriority="high" widths={[640, 960, 1440]} sizes="(min-width: 901px) 58vw, 100vw" /></div>
      <div class="departure__copy">
        <p class="label"><i></i> TRANSPORTE RODOVIÁRIO DE CARGAS</p>
        <h1 id="departure-title">O QUE VAI.<br /><span>PARA ONDE.</span></h1>
        <div class="departure__bottom">
          <p>Carga, origem e destino.<br />É por aí que começamos<br class="desktop-break" /> a planejar sua viagem.</p>
          <a class="dispatch-button" href="#cotacao">Vamos falar de frete <span aria-hidden="true"><Icon name="arrow-diag" size={22} /></span></a>
        </div>
      </div>
      <div class="departure__edge" aria-hidden="true"><span>DA COLETA À ENTREGA</span><svg viewBox="0 0 80 80"><path d="M5 75 70 10M5 10h65v65" fill="none" stroke="currentColor" stroke-width="9" /></svg></div>
      <div class="photo-credit">FOTOGRAFIA ILUSTRATIVA · NÃO REPRESENTA A FROTA</div>
    </section>
    <form class="route-slip" data-road-route aria-label="Informe a origem e o destino">
      <div class="route-slip__heading"><span class="label">O PERCURSO</span><strong>De onde.<br /> Para onde.</strong></div>
      <label><span>ORIGEM</span><input name="origin" placeholder="Cidade de coleta" required autocomplete="address-level2" /></label>
      <span class="route-slip__arrow" aria-hidden="true"><Icon name="arrow" size={44} /></span>
      <label><span>DESTINO</span><input name="destination" placeholder="Cidade de entrega" required /></label>
      <button type="submit">Continuar cotação <span aria-hidden="true"><Icon name="arrow-diag" size={22} /></span></button>
      <p>Atendimento sujeito à rota e à disponibilidade. A equipe analisa sua solicitação.</p>
    </form>
    <section class="services" id="servicos" aria-labelledby="services-title">
      <div class="section-head"><span class="label">O QUE TRANSPORTAMOS</span><h2 id="services-title">A carga define<br />o transporte.</h2><p>Um pedido pontual ou uma viagem dedicada.<br />Conte o que precisa seguir viagem.</p></div>
      <div class="service-ledger">
        <a class="service-entry" href={serviceLinks[0] ? url(`solucoes/${serviceLinks[0].slug}`) : '#cotacao'}><div class="service-entry__tag">COLETA / ENTREGA</div><div class="service-entry__body"><h3>De um endereço<br />ao outro.</h3><p>Transporte rodoviário conforme o perfil da carga e o percurso. Origem, destino e cuidados alinhados antes da coleta.</p><span class="service-entry__link">Transporte de cargas <b aria-hidden="true"><Icon name="arrow-diag" size={22} /></b></span></div><svg class="cargo-drawing" viewBox="0 0 220 150" aria-hidden="true"><path d="m50 54 65-33 65 33-65 34Zm0 0v60l65 33 65-33V54M115 88v59M83 38l65 33v32" fill="none" stroke="currentColor" stroke-width="2"/><path d="M17 126h27m145 0h23M115 2v12" stroke="currentColor" stroke-width="2"/></svg></a>
        <a class="service-entry service-entry--dark" href={serviceLinks[1] ? url(`solucoes/${serviceLinks[1].slug}`) : '#cotacao'}><div class="service-entry__tag">VIAGEM DEDICADA</div><div class="service-entry__body"><h3>Uma viagem.<br />A sua operação.</h3><p>Consulte a disponibilidade de um veículo reservado para a sua carga, com programação definida na contratação.</p><span class="service-entry__link">Transporte dedicado <b aria-hidden="true"><Icon name="arrow-diag" size={22} /></b></span></div><svg class="cargo-drawing" viewBox="0 0 220 150" aria-hidden="true"><path d="M10 105h138V43H10Zm138 0h59V80l-25-28h-34m0 28h59M169 53v27M10 116h197" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="47" cy="111" r="12" fill="var(--asphalt)" stroke="currentColor" stroke-width="2"/><circle cx="175" cy="111" r="12" fill="var(--asphalt)" stroke="currentColor" stroke-width="2"/><path d="M10 29h65m9 0h26m8 0h20" stroke="currentColor" stroke-width="2"/></svg></a>
      </div>
    </section>
    <section class="before-road" id="percurso" aria-labelledby="before-title">
      <div class="before-road__head"><span class="label">ANTES DE CARREGAR</span><h2 id="before-title">A estrada começa<br />no combinado.</h2><p>Três informações para tirar<br />a viagem do papel.</p><span class="road-symbol" aria-hidden="true"><Icon name="arrow-diag" size={115} /></span></div>
      <ol class="trip-steps">
        <li><span class="step-code">01 / CARGA</span><div><h3>O que vai.</h3><p>Tipo de mercadoria, peso, dimensões e cuidados no manuseio. O que a equipe precisa saber antes de carregar.</p></div></li>
        <li><span class="step-code">02 / PERCURSO</span><div><h3>Por onde segue.</h3><p>Endereços de coleta e entrega, condições de acesso e horários de recebimento.</p></div></li>
        <li><span class="step-code">03 / PROPOSTA</span><div><h3>O que fica acertado.</h3><p>Disponibilidade, condições do transporte e canal de contato definidos antes da contratação.</p></div></li>
      </ol>
    </section>
    <section class="contact-strip" id="atendimento" aria-labelledby="contact-title"><span class="label">QUEM RESPONDE</span><h2 id="contact-title">Fale com quem<br />organiza a viagem.</h2><div><p>Para perguntar sobre uma coleta, alinhar um acesso ou combinar uma entrega: fale com nossa equipe.</p><a href={`mailto:${company.contact.email}`}>{company.contact.email} <span aria-hidden="true"><Icon name="arrow-diag" size={22} /></span></a><a href={`tel:${company.contact.phone.replace(/[^\d+]/g, '')}`}>{company.contact.phone}</a></div></section>
    <section class="dispatch" id="cotacao" aria-labelledby="dispatch-title">
      <div class="dispatch__intro"><span class="label">SOLICITAÇÃO DE TRANSPORTE</span><h2 id="dispatch-title">Vamos tirar<br />do papel?</h2><p>Informe a carga e a rota.<br />Um especialista analisa os detalhes<br />e responde com os valores do frete.</p><div class="dispatch__stamp"><svg viewBox="0 0 50 50" aria-hidden="true"><path d="M3 25h43M27 5l20 20-20 20" fill="none" stroke="currentColor" stroke-width="4"/></svg><span>COTAÇÃO ANALISADA<br />PELA EQUIPE.</span></div></div>
      <form class="dispatch-form" data-road-quote data-number={whatsapp} data-email={quoteEmail} data-brand={brand.name}>
        <div class="dispatch-form__header"><strong>FICHA DE TRANSPORTE</strong><span>DADOS DA SOLICITAÇÃO</span></div>
        <p class="required-note">Os campos com * são obrigatórios.</p>
        <div class="form-row"><label><span>SEU NOME *</span><input name="name" required autocomplete="name" placeholder="Como podemos chamar você?" /></label><label><span>EMPRESA</span><input name="company" autocomplete="organization" placeholder="Nome da empresa" /></label></div>
        <div class="form-row"><label><span>ORIGEM *</span><input name="origin" required placeholder="Cidade / UF" autocomplete="address-level2" /></label><label><span>DESTINO *</span><input name="destination" required placeholder="Cidade / UF" /></label></div>
        <label><span>O QUE SERÁ TRANSPORTADO? *</span><input name="cargo" required placeholder="Mercadoria, peso e dimensões, se souber" /></label>
        <div class="form-row"><label><span>TELEFONE</span><input name="phone" type="tel" autocomplete="tel" placeholder="DDD + número" /></label><label><span>E-MAIL</span><input name="email" type="email" autocomplete="email" placeholder="Seu e-mail" /></label></div>
        <label><span>ALGO MAIS SOBRE A VIAGEM?</span><textarea name="notes" rows="2" placeholder="Data desejada, restrições de acesso ou outros detalhes"></textarea></label>
        <div class="form-actions">{whatsapp && <button class="dispatch-button" type="submit" value="whatsapp">Enviar pelo WhatsApp <span aria-hidden="true"><Icon name="arrow-diag" size={22} /></span></button>}<button class="email-button" type="submit" value="email">Enviar por e-mail <span aria-hidden="true"><Icon name="arrow-diag" size={22} /></span></button></div>
        <p class="dispatch-form__notice">O formulário prepara uma mensagem no canal escolhido. Este site não calcula frete nem armazena os dados preenchidos.</p>
        <p class="form-status" role="status" data-road-status></p>
      </form>
    </section>
  </main>
  <footer class="road-footer"><div class="road-footer__top"><a class="wordmark" href="#principal"><svg viewBox="0 0 46 40" aria-hidden="true"><path d="M0 0h21l20 20-20 20H0l20-20Z" fill="currentColor"/></svg><span>{brand.name.toLowerCase()}<small>TRANSPORTES</small></span></a><p>Carga. Percurso. Próxima parada.</p><a href="#principal">Voltar ao início <Icon name="arrow" size={14} /></a></div><div class="road-footer__bottom"><p>{brand.legalName}</p><p>Fotografia ilustrativa: <a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash <Icon name="arrow-diag" size={22} /></a></p></div>{demo.enabled && <p class="road-demo">{demo.notice}</p>}</footer>
</body>
</html>

<style is:global>
.road { --asphalt:#171a18; --paper:#f1f0e9; --signal:#f56832; --road-line:#b4b4a9; --road-mono:'IBM Plex Mono',monospace; color:var(--asphalt); background:var(--paper); font-family:'IBM Plex Sans',sans-serif; line-height:1.45; }
.road * { box-sizing:border-box; } .road a { color:inherit; text-decoration:none; } .road button,.road input,.road textarea { font:inherit; } .road button,.road a,.road input,.road textarea { -webkit-tap-highlight-color:transparent; } .road :focus-visible { outline:3px solid #287baf; outline-offset:5px; } .road button { cursor:pointer; } .road h1,.road h2,.road h3,.road p { margin:0; } .road button { border:0; border-radius:0; }
.road .label { font:11px/1.5 var(--road-mono); letter-spacing:.09em; text-transform:uppercase; }
.road-skip { position:fixed; top:-100px; left:20px; padding:12px 20px; background:var(--paper); z-index:10; } .road-skip:focus { top:10px; }
.edition { display:flex; justify-content:space-between; padding:10px 4.2%; border-bottom:1px solid #cbcbbf; font:9px var(--road-mono); letter-spacing:.06em; }
.masthead { padding:22px 4.2%; display:flex; align-items:center; gap:40px; min-height:100px; background:var(--paper); }
.wordmark { display:flex; gap:12px; align-items:center; flex-shrink:0; } .wordmark svg { width:40px; height:36px; } .wordmark>span { font-family:'Space Grotesk Variable',sans-serif; font-size:39px; font-weight:700; line-height:.9; letter-spacing:-.055em; } .wordmark small { display:block; font:8px var(--road-mono); letter-spacing:.29em; margin-top:9px; }
.road-nav { display:flex; gap:32px; margin-left:auto; font-size:14px; } .road-nav a { padding-block:8px; border-bottom:1px solid transparent; } .road-nav a:hover { border-color:currentColor; }
.header-quote { display:flex; justify-content:space-between; align-items:center; gap:25px; font-size:13px; font-weight:600; border:1px solid var(--asphalt); padding:13px 16px; } .header-quote span { font-size:22px; } .road-menu-toggle { display:none; }
.departure { min-height:650px; background:var(--asphalt); color:var(--paper); position:relative; overflow:hidden; isolation:isolate; }
.departure__photo { position:absolute; inset:0 0 0 42%; z-index:-2; } .departure__photo img,.departure__photo picture { width:100%; height:100%; display:block; object-fit:cover; filter:grayscale(1); } .departure__photo:after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,var(--asphalt),transparent 40%),linear-gradient(0deg,rgba(23,26,24,.7),transparent 50%); }
.departure__copy { padding:50px 4.2% 60px; position:relative; } .departure .label { display:flex; gap:12px; align-items:center; } .departure .label i { display:block; width:7px; height:7px; background:var(--signal); }
.departure h1 { font-family:'Space Grotesk Variable',sans-serif; font-size:clamp(70px,10.2vw,160px); font-weight:700; line-height:.91; letter-spacing:-.075em; margin-top:53px; position:relative; max-width:12ch; }
.departure h1 span { color:var(--signal); } .departure__bottom { display:flex; gap:55px; align-items:end; margin-top:40px; } .departure__bottom p { font-size:19px; max-width:30ch; color:#deded5; }
.dispatch-button { background:var(--signal); color:var(--asphalt)!important; display:inline-flex; align-items:center; justify-content:space-between; gap:30px; padding:18px 22px; font-weight:600; font-size:15px; min-height:60px; transition:background .15s; } .dispatch-button:hover { background:#ff8759; } .dispatch-button span { font-size:29px; line-height:1; }
.departure__edge { position:absolute; right:4.2%; top:50px; width:96px; display:grid; gap:12px; } .departure__edge>span { font:9px var(--road-mono); letter-spacing:.04em; } .departure__edge svg { color:var(--signal); width:78px; margin-left:auto; } .photo-credit { position:absolute; right:4.2%; bottom:22px; font:9px var(--road-mono); letter-spacing:.07em; color:#e1e1d9; }
.route-slip { display:grid; grid-template-columns:1fr 1.25fr 50px 1.25fr auto; gap:25px; align-items:center; margin:0 4.2%; padding:33px 0 21px; border-bottom:1px solid var(--asphalt); } .route-slip__heading strong { display:block; font-size:21px; line-height:1.1; font-weight:500; margin-top:7px; } .route-slip label,.dispatch-form label { display:grid; gap:9px; min-width:0; } .route-slip label>span,.dispatch-form label>span { font:10px var(--road-mono); letter-spacing:.06em; } .route-slip input { width:100%; border:0; border-bottom:1px solid var(--road-line); background:transparent; padding:10px 0; font-size:17px; min-height:45px; border-radius:0; color:var(--asphalt); } .route-slip__arrow { font-size:38px; } .route-slip button { display:flex; justify-content:space-between; align-items:center; gap:20px; background:var(--asphalt); color:var(--paper); padding:16px 20px; font-size:13px; min-height:53px; } .route-slip button span { margin-left:25px; font-size:20px; } .route-slip>p { grid-column:2/-1; font-size:11px; color:#5c6058; }
.services { padding:90px 4.2% 85px; } .section-head { display:grid; grid-template-columns:1fr 2fr 1.4fr; align-items:start; gap:24px; margin-bottom:40px; } .section-head .label { padding-top:10px; } .road h2 { font-family:'Space Grotesk Variable',sans-serif; font-size:clamp(34px,4.3vw,66px); line-height:1.04; letter-spacing:-.055em; font-weight:500; } .section-head>p { font-size:15px; padding-top:10px; color:#54574f; }
.service-ledger { display:grid; grid-template-columns:1.2fr 1fr; gap:22px; } .service-entry { position:relative; display:grid; grid-template-columns:105px 1fr; border:1px solid var(--asphalt); min-height:345px; padding:26px; gap:22px; overflow:hidden; } .service-entry__tag { font:9px var(--road-mono); writing-mode:vertical-rl; transform:rotate(180deg); align-self:start; justify-self:start; border-left:1px solid var(--asphalt); padding-left:14px; letter-spacing:.06em; height:120px; } .service-entry h3 { font-family:'Space Grotesk Variable',sans-serif; font-size:clamp(28px,3vw,43px); line-height:1.1; font-weight:500; letter-spacing:-.045em; } .service-entry p { font-size:14px; max-width:33ch; margin-top:20px; position:relative; z-index:1; } .service-entry__link { display:flex; gap:20px; align-items:center; margin-top:32px; font-size:12px; text-decoration:underline; text-underline-offset:5px; } .service-entry__link b { font-size:23px; font-weight:400; } .cargo-drawing { position:absolute; width:150px; right:-12px; bottom:4px; opacity:.18; } .service-entry--dark { background:var(--asphalt); color:var(--paper)!important; } .service-entry--dark .service-entry__tag { border-color:#81847b; color:var(--signal); } .service-entry:hover .service-entry__link { text-decoration-thickness:2px; }
.before-road { display:grid; grid-template-columns:1fr 1.35fr; gap:9%; padding:80px 4.2%; background:#dfdfd5; border-top:1px solid #c0c2b5; border-bottom:1px solid #c0c2b5; } .before-road__head h2 { margin-top:28px; font-size:clamp(34px,3.8vw,58px); } .before-road__head>p { margin-top:24px; color:#53574d; } .road-symbol svg { transform:rotate(90deg); } .road-symbol { color:var(--signal); font-family:'IBM Plex Sans',sans-serif; font-weight:400; display:block; font-size:125px; line-height:1; margin-top:25px; } .trip-steps { list-style:none; padding:0; } .trip-steps li { border-top:1px solid #8a8f80; padding:25px 0 28px; display:grid; grid-template-columns:115px 1fr; gap:20px; } .step-code { font:10px var(--road-mono); padding-top:7px; } .trip-steps h3 { font-size:26px; font-weight:500; letter-spacing:-.035em; } .trip-steps p { font-size:14px; color:#4d5348; max-width:43ch; margin-top:10px; }
.contact-strip { padding:63px 4.2%; display:grid; grid-template-columns:1fr 2fr 1.4fr; gap:25px; border-bottom:1px solid var(--asphalt); } .contact-strip .label { padding-top:9px; } .contact-strip h2 { font-size:clamp(30px,3vw,44px); } .contact-strip p { font-size:14px; margin-bottom:20px; max-width:35ch; } .contact-strip>div>a { display:block; margin-top:10px; font-size:14px; text-decoration:underline; text-underline-offset:4px; overflow-wrap:anywhere; }
.dispatch { padding:80px 4.2% 90px; display:grid; grid-template-columns:1fr 1.65fr; gap:7%; } .dispatch__intro h2 { margin-top:24px; font-size:clamp(42px,5.5vw,84px); } .dispatch__intro>p { font-size:16px; margin-top:27px; line-height:1.6; } .dispatch__stamp { display:flex; align-items:center; gap:15px; border-top:1px solid var(--asphalt); padding-top:22px; margin-top:50px; max-width:270px; } .dispatch__stamp svg { width:45px; color:#b74920; } .dispatch__stamp span { font:11px var(--road-mono); line-height:1.5; }
.dispatch-form { border:1px solid var(--asphalt); padding:26px; background:#f8f7f1; display:grid; gap:23px; min-width:0; } .dispatch-form__header { display:flex; justify-content:space-between; gap:20px; padding-bottom:18px; border-bottom:2px solid var(--asphalt); } .dispatch-form__header strong { font:12px var(--road-mono); } .dispatch-form__header>span { font:9px var(--road-mono); } .required-note { font-size:11px; color:#5d6056; } .form-row { display:grid; grid-template-columns:1fr 1fr; gap:22px; } .dispatch-form input,.dispatch-form textarea { padding:10px 0; border:0; border-radius:0; border-bottom:1px solid #9b9f91; color:var(--asphalt); width:100%; min-width:0; background:transparent; font-size:14px; min-height:43px; } .dispatch-form textarea { resize:vertical; } .dispatch-form ::placeholder,.route-slip ::placeholder { color:#73766c; opacity:1; } .form-actions { display:flex; flex-wrap:wrap; gap:18px; align-items:center; margin-top:5px; } .dispatch-form .dispatch-button { font-size:13px; min-height:53px; padding:14px 18px; gap:22px; } .dispatch-form .dispatch-button span { font-size:24px; } .email-button svg { display:inline-block; vertical-align:middle; margin-left:8px; width:14px; height:14px; } .email-button { background:none; padding:12px 0; text-decoration:underline; font-size:12px!important; color:var(--asphalt); text-underline-offset:4px; } .dispatch-form__notice { font-size:11px; line-height:1.6; color:#565c50; max-width:65ch; } .form-status:empty { display:none; } .form-status { font-size:13px; }
.road-footer { background:var(--asphalt); color:var(--paper); padding:45px 4.2% 24px; } .road-footer__top { display:flex; gap:35px; align-items:center; padding-bottom:35px; border-bottom:1px solid #44483e; } .road-footer__top>p { font-size:16px; margin-left:auto; } .road-footer__top>a:last-child svg { transform:rotate(-90deg); vertical-align:middle; margin-left:8px; } .road-footer__bottom svg { width:10px; height:10px; } .road-footer__top>a:last-child { font:10px var(--road-mono); margin-left:30px; } .road-footer__bottom { display:flex; justify-content:space-between; gap:20px; font-size:10px; color:#bec2b6; margin-top:20px; } .road-demo { font-size:10px; color:#bec2b6; margin-top:15px; max-width:90ch; }
@media(min-width:1600px) { .departure { min-height:740px; } .departure__copy { padding-top:60px; } }
