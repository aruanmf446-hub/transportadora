---
/** Operational structure — units as an editorial index with stats + image. */
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { site, pad, mapsLink, type ResolvedSection } from '../lib/site';
interface Props { section: ResolvedSection; anchors: string[] }
const { section, anchors } = Astro.props;
const c = section.content;
const units = site.company.units;
---
<Section section={section} class="op">
  <div class="container">
    <SectionHead eyebrow={c.eyebrow} title={c.title} lead={c.lead} cta={c.cta} anchors={anchors} />
    <ol class="op__list">
      {units.map((u, i) => (
        <li class="op__row" data-reveal="fade" data-delay={String(i * 0.05)}>
          <span class="op__num mono">{pad(i + 1)}</span>
          <div class="op__name"><h3 class="h3">{u.name}</h3>{u.hq && <span class="op__hq mono">Matriz</span>}</div>
          <p class="op__kind mono">{u.kind}</p>
          <p class="op__city">{u.city}{u.state && ` / ${u.state}`}</p>
          <a class="op__map" href={mapsLink(u.address, u.mapsUrl)} target="_blank" rel="noopener noreferrer" aria-label={`Ver ${u.name} no mapa (abre em nova aba)`}><Icon name="pin" /></a>
        </li>
      ))}
    </ol>
  </div>
</Section>
<style>
  .op__list { border-top: 1px solid var(--fg); }
  .op__row { display: grid; grid-template-columns: 3.5rem minmax(0, 4fr) minmax(0, 3fr) minmax(0, 2fr) 3rem; gap: var(--col-gap); align-items: center; padding-block: 22px; border-bottom: 1px solid var(--line); transition: padding 0.5s var(--ease-out); }
  .op__row:hover { padding-block: 30px; }
  .op__num { color: var(--muted); }
  .op__name { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .op__hq { padding: 3px 8px; background: var(--accent); color: var(--on-accent); border-radius: 99px; }
  .op__kind { color: var(--muted); }
  .op__map { justify-self: end; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line); transition: background-color 0.3s, color 0.3s; }
  .op__map:hover { background: var(--fg); color: var(--bg); }
  @media (max-width: 900px) { .op__row { grid-template-columns: 2.4rem 1fr 3rem; row-gap: 6px; } .op__kind, .op__city { grid-column: 2; } .op__map { grid-column: 3; grid-row: 1; } }
</style>
