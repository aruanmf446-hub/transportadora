---
/** Optional 3D globe for international connections (not every carrier needs it). */
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import { site, pad, type ResolvedSection } from '../lib/site';
interface Props { section: ResolvedSection; anchors: string[] }
const { section, anchors } = Astro.props;
const c = section.content;
const g = site.data.geo.globe;
const byId = new Map(g.points.map((p) => [p.id, p]));
const coord = (lat: number, lon: number) => `${Math.abs(lat).toFixed(1)}°${lat >= 0 ? 'N' : 'S'} ${Math.abs(lon).toFixed(1)}°${lon >= 0 ? 'L' : 'O'}`;
---
<Section section={section} class="gl">
  <div class="container gl__grid">
    <div class="gl__head">
      <SectionHead eyebrow={c.eyebrow} title={c.title} lead={c.lead} cta={c.cta} anchors={anchors} layout="stack" />
      <ol class="gl__list" data-reveal="stagger">
        {g.arcs.map((a, i) => {
          const A = byId.get(a.from), B = byId.get(a.to);
          return A && B && (
            <li><span class="mono muted">{pad(i + 1)}</span><span>{A.name} <span class="accent">→</span> {B.name}</span><span class="mono muted gl__c">{coord(B.lat, B.lon)}</span></li>
          );
        })}
      </ol>
    </div>
    <div class="gl__stage" data-gl-stage data-globe={JSON.stringify(g)} data-mobile={site.scene3d.mobileQuality} data-enabled={site.scene3d.enabled ? '1' : '0'}>
      <svg class="gl__fallback" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-opacity=".3" />
        <ellipse cx="100" cy="100" rx="40" ry="90" fill="none" stroke="currentColor" stroke-opacity=".15" />
        <ellipse cx="100" cy="100" rx="90" ry="30" fill="none" stroke="currentColor" stroke-opacity=".15" />
        <path d="M70 140 Q 110 40 160 70" fill="none" stroke="var(--accent)" />
      </svg>
    </div>
  </div>
</Section>
<style>
  .gl__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--col-gap); align-items: center; }
  .gl__head { grid-column: 1 / span 5; }
  .gl__head :global(.shead) { grid-template-columns: 1fr; margin-bottom: 40px; }
  .gl__list { border-top: 1px solid var(--line); }
  .gl__list li { display: grid; grid-template-columns: 2.4rem 1fr auto; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
  .gl__c { font-size: 0.625rem; }
  .gl__stage { grid-column: 6 / -1; position: relative; aspect-ratio: 1; max-height: 80vh; color: var(--fg); cursor: grab; touch-action: pan-y; }
  .gl__stage :global(.stage-canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; opacity: 0; transition: opacity 1.2s; }
  .gl__stage:global(.is-ready) :global(.stage-canvas) { opacity: 1; }
  .gl__fallback { position: absolute; inset: 10%; transition: opacity 0.6s; }
  .gl__stage:global(.is-ready) .gl__fallback { opacity: 0; }
  .gl :global(.stage-labels) { position: absolute; inset: 0; pointer-events: none; }
  .gl :global(.globe-label) { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 6px; translate: 8px -50%; background: color-mix(in srgb, var(--bg) 80%, transparent); transition: opacity 0.4s; white-space: nowrap; }
  .gl :global(.globe-label.is-origin) { background: var(--c-accent); color: var(--c-on-accent); }
  @media (max-width: 1023px) { .gl__head, .gl__stage { grid-column: 1 / -1; } .gl__stage { margin-top: 32px; } }
</style>
<script>
  import { whenNear } from '../scripts/motion/core';
  import { decideQuality } from '../scripts/three/stage';
  document.querySelectorAll<HTMLElement>('[data-gl-stage]').forEach((el) => {
    const quality = el.dataset.enabled === '1' ? decideQuality((el.dataset.mobile as 'off' | 'low' | 'full') ?? 'low') : null;
    if (!quality) return;
    whenNear(el, async () => {
      try {
        const { mountGlobe } = await import('../scripts/three/scenes/globe');
        await mountGlobe(el, quality, JSON.parse(el.dataset.globe || '{}'));
      } catch (e) { console.warn('[globe] fallback kept', e); }
    });
  });
</script>
